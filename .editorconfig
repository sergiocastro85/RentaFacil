root = true

[*]
indent_style = space
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4

# Organización de using
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Namespaces con file-scoped
csharp_style_namespace_declarations = file_scoped:warning

# Preferir 'var' cuando el tipo es evidente
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Miembros y expresiones
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_prefer_braces = true:suggestion

# Modificadores
dotnet_style_require_accessibility_modifiers = always:suggestion
dotnet_style_readonly_field = true:suggestion

# Nomenclatura: interfaces con prefijo "I"
dotnet_naming_rule.interfaces_deben_empezar_con_i.severity = suggestion
dotnet_naming_rule.interfaces_deben_empezar_con_i.symbols = interfaces
dotnet_naming_rule.interfaces_deben_empezar_con_i.style = prefijo_i

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefijo_i.required_prefix = I
dotnet_naming_style.prefijo_i.capitalization = pascal_case

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
